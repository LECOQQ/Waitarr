# Copy to .env next to docker-compose.yml, then `chmod 600 .env`.
TZ=Europe/Paris
# The address the health endpoint is published on.
HOST_IP=127.0.0.1
WAITARR_PORT=8778

# Jellyfin: Dashboard > API Keys > +
WAITARR_JELLYFIN_API_KEY=
# qBittorrent WebUI password of the target named "main"
WAITARR_MAIN_PASSWORD=

# "observe" to see first: logs what it would do, touches nothing.
# Empty: waitarr.toml decides, then the default ("active").
WAITARR_MODE=

# Optional
WAITARR_LOG_LEVEL=
WAITARR_POLL_INTERVAL=
WAITARR_NOTIFY_NTFY_URL=
WAITARR_HEALTHCHECKS_URL=
